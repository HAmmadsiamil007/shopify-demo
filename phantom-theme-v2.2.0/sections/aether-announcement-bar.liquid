<div
  class="aether-announcement-bar ph-client ph-client--aether"
  data-section-type="aether-announcement-bar"
  data-aether-motion-enabled="{{ settings.aether_motion_enable }}"
>
  <div class="announcement-content">
    {%- for block in section.blocks -%}
      {%- if forloop.first != true -%}
        <span class="separator" aria-hidden="true">|</span>
      {%- endif -%}
      <span {{ block.shopify_attributes }}>
        {%- render 'aether-icon', name: block.settings.icon, class: 'aether-announcement-bar__icon' -%}
        {{ block.settings.text | escape }}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
  {
    "name": "t:sections.aether-announcement-bar.name",
    "settings": [],
    "blocks": [
      {
        "type": "message",
        "name": "t:sections.aether-announcement-bar.blocks.message.name",
        "settings": [
          {
            "type": "select",
            "id": "icon",
            "options": [
              {
                "value": "fa-truck",
                "label": "t:sections.aether-announcement-bar.blocks.message.settings.icon.options.fa-truck"
              },
              {
                "value": "fa-bolt",
                "label": "t:sections.aether-announcement-bar.blocks.message.settings.icon.options.fa-bolt"
              },
              {
                "value": "fa-undo",
                "label": "t:sections.aether-announcement-bar.blocks.message.settings.icon.options.fa-undo"
              }
            ],
            "default": "fa-truck",
            "label": "t:sections.aether-announcement-bar.blocks.message.settings.icon.label"
          },
          {
            "type": "text",
            "id": "text",
            "default": "Free shipping on orders over $200",
            "label": "t:sections.aether-announcement-bar.blocks.message.settings.text.label"
          }
        ]
      }
    ],
    "max_blocks": 3,
    "presets": [
      {
        "name": "t:sections.aether-announcement-bar.presets.default.name"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}
