.ph-client--demo {
  --demo-z-sticky: 5000;
  --demo-z-drawer: 9000;
  --demo-z-modal: 9050;
  --demo-z-toast: 9500;
  --demo-z-3d: 9700;
}
.ph-client--demo .container {
  --bs-gutter-x: 1.5rem;
  --bs-gutter-y: 0;
  width: 100%;
  padding-right: calc(var(--bs-gutter-x) * 0.5);
  padding-left: calc(var(--bs-gutter-x) * 0.5);
  margin-right: auto;
  margin-left: auto;
}
@media (min-width: 576px) {
   .ph-client--demo .container {
    max-width: 540px;
  }
}
@media (min-width: 768px) {
   .ph-client--demo .container {
    max-width: 720px;
  }
}
@media (min-width: 992px) {
   .ph-client--demo .container {
    max-width: 960px;
  }
}
@media (min-width: 1200px) {
   .ph-client--demo .container {
    max-width: 1140px;
  }
}
@media (min-width: 1400px) {
   .ph-client--demo .container {
    max-width: 1320px;
  }
}
.ph-client--demo :root {
  --bs-breakpoint-xs: 0;
  --bs-breakpoint-sm: 576px;
  --bs-breakpoint-md: 768px;
  --bs-breakpoint-lg: 992px;
  --bs-breakpoint-xl: 1200px;
  --bs-breakpoint-xxl: 1400px;
}
.ph-client--demo .row {
  --bs-gutter-x: 1.5rem;
  --bs-gutter-y: 0;
  display: flex;
  flex-wrap: wrap;
  margin-top: calc(-1 * var(--bs-gutter-y));
  margin-right: calc(-0.5 * var(--bs-gutter-x));
  margin-left: calc(-0.5 * var(--bs-gutter-x));
}
.ph-client--demo .row > * {
  flex-shrink: 0;
  width: 100%;
  max-width: 100%;
  padding-right: calc(var(--bs-gutter-x) * 0.5);
  padding-left: calc(var(--bs-gutter-x) * 0.5);
  margin-top: var(--bs-gutter-y);
}
.ph-client--demo .col-12 {
  flex: 0 0 auto;
  width: 100%;
}
.ph-client--demo .g-4 {
  --bs-gutter-x: 1.5rem;
}
.ph-client--demo .g-4 {
  --bs-gutter-y: 1.5rem;
}
@media (min-width: 576px) {
  .ph-client--demo .col-sm-6 {
    flex: 0 0 auto;
    width: 50%;
  }
}
@media (min-width: 768px) {
  .ph-client--demo .col-md-4 {
    flex: 0 0 auto;
    width: 33.33333333%;
  }
}
.ph-client--demo .btn {
  --bs-btn-padding-x: 0.75rem;
  --bs-btn-padding-y: 0.375rem;
  --bs-btn-font-family: ;
  --bs-btn-font-size: 1rem;
  --bs-btn-font-weight: 400;
  --bs-btn-line-height: 1.5;
  --bs-btn-color: var(--bs-body-color);
  --bs-btn-bg: transparent;
  --bs-btn-border-width: var(--bs-border-width);
  --bs-btn-border-color: transparent;
  --bs-btn-border-radius: var(--bs-border-radius);
  --bs-btn-hover-border-color: transparent;
  --bs-btn-box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 1px 1px rgba(0, 0, 0, 0.075);
  --bs-btn-disabled-opacity: 0.65;
  --bs-btn-focus-box-shadow: 0 0 0 0.25rem rgba(var(--bs-btn-focus-shadow-rgb), .5);
  display: inline-block;
  padding: var(--bs-btn-padding-y) var(--bs-btn-padding-x);
  font-family: var(--bs-btn-font-family);
  font-size: var(--bs-btn-font-size);
  font-weight: var(--bs-btn-font-weight);
  line-height: var(--bs-btn-line-height);
  color: var(--bs-btn-color);
  text-align: center;
  text-decoration: none;
  vertical-align: middle;
  cursor: pointer;
  user-select: none;
  border: var(--bs-btn-border-width) solid var(--bs-btn-border-color);
  border-radius: var(--bs-btn-border-radius);
  background-color: var(--bs-btn-bg);
  transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}
@media (prefers-reduced-motion: reduce) {
  .ph-client--demo .btn {
    transition: none;
  }
}
.ph-client--demo .btn:hover {
  color: var(--bs-btn-hover-color);
  background-color: var(--bs-btn-hover-bg);
  border-color: var(--bs-btn-hover-border-color);
}
.ph-client--demo .btn:focus-visible {
  color: var(--bs-btn-hover-color);
  background-color: var(--bs-btn-hover-bg);
  border-color: var(--bs-btn-hover-border-color);
  outline: 0;
  box-shadow: var(--bs-btn-focus-box-shadow);
}
 :not(.btn-check) + .ph-client--demo .btn:active, .ph-client--demo .btn:first-child:active {
  color: var(--bs-btn-active-color);
  background-color: var(--bs-btn-active-bg);
  border-color: var(--bs-btn-active-border-color);
}
 :not(.btn-check) + .ph-client--demo .btn:active:focus-visible, .ph-client--demo .btn:first-child:active:focus-visible {
  box-shadow: var(--bs-btn-focus-box-shadow);
}
.ph-client--demo .btn:disabled {
  color: var(--bs-btn-disabled-color);
  pointer-events: none;
  background-color: var(--bs-btn-disabled-bg);
  border-color: var(--bs-btn-disabled-border-color);
  opacity: var(--bs-btn-disabled-opacity);
}
.ph-client--demo .btn-primary {
  --bs-btn-color: #fff;
  --bs-btn-bg: #0d6efd;
  --bs-btn-border-color: #0d6efd;
  --bs-btn-hover-color: #fff;
  --bs-btn-hover-bg: rgb(4.3333333333%, 36.6666666667%, 84.3333333333%);
  --bs-btn-hover-border-color: rgb(4.0784313725%, 34.5098039216%, 79.3725490196%);
  --bs-btn-focus-shadow-rgb: 49, 132, 253;
  --bs-btn-active-color: #fff;
  --bs-btn-active-bg: rgb(4.0784313725%, 34.5098039216%, 79.3725490196%);
  --bs-btn-active-border-color: rgb(3.8235294118%, 32.3529411765%, 74.4117647059%);
  --bs-btn-active-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.125);
  --bs-btn-disabled-color: #fff;
  --bs-btn-disabled-bg: #0d6efd;
  --bs-btn-disabled-border-color: #0d6efd;
}
.ph-client--demo {
  --demo-bg: var(--ph-colorBody);
  --demo-text: var(--ph-colorTextBody);
  --demo-muted: color-mix(in srgb, var(--ph-colorTextBody) 62%, var(--ph-colorBody));
  --demo-accent: var(--ph-colorBtnPrimary);
  --demo-accent-text: var(--ph-colorBtnPrimaryText);
  --demo-card-bg: var(--ph-colorBody);
  --demo-border: var(--ph-colorBorders);
  --demo-sale: var(--ph-colorSaleTag);
  --demo-sale-text: var(--ph-colorSaleTagText);
}
.ph-client--demo .ph-client__hero {
  padding: 96px 0 72px;
  text-align: center;
}
.ph-client--demo .ph-client__hero-eyebrow {
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-size: 0.78rem;
  color: var(--demo-muted);
  margin-bottom: 16px;
}
.ph-client--demo .ph-client__hero-title {
  font-size: 3.25rem;
  font-weight: 400;
  line-height: 1.1;
  margin-bottom: 16px;
}
.ph-client--demo .ph-client__hero-subtitle {
  font-size: 1.15rem;
  color: var(--demo-muted);
  max-width: 560px;
  margin: 0 auto 28px;
}
.ph-client--demo .ph-client__hero-placeholder {
  height: 300px;
  border-radius: 12px;
  margin-bottom: 40px;
  background: linear-gradient(120deg, #d8cfc0 0%, #f0e9dd 45%, #c9d8cc 100%);
}
.ph-client--demo .ph-client__collection {
  padding: 0 0 80px;
}
.ph-client--demo .ph-client__collection-title {
  text-align: center;
  font-size: 2rem;
  font-weight: 400;
  margin-bottom: 40px;
}
.ph-client--demo .ph-client__card {
  background: var(--demo-card-bg);
  border: 1px solid var(--demo-border);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  position: relative;
  height: 100%;
}
.ph-client--demo .ph-client__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(43, 38, 32, 0.12);
}
.ph-client--demo .ph-client__card-media {
  aspect-ratio: 4/5;
  background: #efe9de;
}
.ph-client--demo .ph-client__card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ph-client--demo .ph-client__card-body {
  padding: 16px 18px 20px;
}
.ph-client--demo .ph-client__card-title {
  font-size: 1.05rem;
  font-weight: 400;
  margin-bottom: 6px;
}
.ph-client--demo .ph-client__card-title a {
  color: var(--demo-text);
  text-decoration: none;
}
.ph-client--demo .ph-client__card-title a:hover {
  color: var(--demo-accent);
}
.ph-client--demo .ph-client__card-price {
  color: var(--demo-muted);
}
.ph-client--demo .ph-client__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: var(--demo-sale);
  color: var(--demo-sale-text);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 10px;
  border-radius: 999px;
}
.ph-client--demo .ph-client__card-soldout {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(247, 244, 238, 0.82);
  color: var(--demo-text);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.8rem;
}
.ph-client--demo .btn-primary {
  background: var(--demo-accent);
  border-color: var(--demo-accent);
  border-radius: 999px;
  padding: 12px 32px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.82rem;
}
.ph-client--demo .btn-primary:hover,
.ph-client--demo .btn-primary:focus {
  background: color-mix(in srgb, var(--demo-accent) 82%, #000);
  border-color: color-mix(in srgb, var(--demo-accent) 82%, #000);
}
.ph-client--demo .ph-client__footer {
  border-top: 1px solid var(--demo-border);
  padding: 48px 0 24px;
}
.ph-client--demo .ph-client__footer-brand {
  font-size: 1.15rem;
  margin-bottom: 8px;
}
.ph-client--demo .ph-client__footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}
.ph-client--demo .ph-client__footer-links a {
  color: var(--demo-muted);
  text-decoration: none;
}
.ph-client--demo .ph-client__footer-links a:hover {
  color: var(--demo-accent);
}
.ph-client--demo .ph-client__footer-copy {
  text-align: center;
  color: var(--demo-muted);
  font-size: 0.85rem;
  margin: 32px 0 0;
}
@media (prefers-reduced-motion: reduce) {
  .ph-client--demo .ph-client__reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
}