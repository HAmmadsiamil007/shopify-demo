Buttons (frozen .btn family) {%- endcomment -%}
.aether-btn {position:relative;display:inline-block;padding:16px 40px;font-weight:500;font-size:0.9rem;letter-spacing:0.05em;text-transform:uppercase;border:none;border-radius:0;cursor:pointer;overflow:hidden;text-decoration:none;transition:all 0.35s cubic-bezier(0.16,1,0.3,1);}
