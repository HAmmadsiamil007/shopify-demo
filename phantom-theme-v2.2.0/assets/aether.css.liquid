Rotating announcement text (frozen responsive.css:365-392){%- endcomment -%}
.aether-mobile-announcement{flex:1;text-align:center;overflow:hidden;height:20px;position:relative;}
.aether-mobile-announcement__text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--aether-text);opacity:0;transition:opacity 0.5s ease;white-space:nowrap;}
.aether-mobile-announcement__text.active{opacity:1;}{%- comment -%}
Slide-out drawer overlay + panel (frozen responsive.css:394-428){%- endcomment -%}
.aether-mobile-menu-overlay{display:block;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:var(--aether-z-drawer);opacity:0;visibility:hidden;transition:opacity 0.3s ease,visibility 0.3s ease;}
.aether-mobile-menu-overlay.active{opacity:1;visibility:visible;}
.aether-mobile-menu{position:absolute;top:0;left:0;width:100%;max-width:400px;height:100%;background:rgba(9,9,11,0.95);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);transform:translateX(-100%);transition:transform 0.4s cubic-bezier(0.22,1,0.36,1);display:flex;flex-direction:column;overflow-y:auto;-webkit-overflow-scrolling:touch;}
.aether-mobile-menu-overlay.active .aether-mobile-menu{transform:translateX(0);}
.aether-mobile-menu__header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;min-height:60px;border-bottom:1px solid rgba(255,255,255,0.06);flex-shrink:0;}
.aether-mobile-menu__close{width:44px;height:44px;min-width:44px;background:none;border:none;color:var(--aether-text);font-size:1.3rem;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.aether-mobile-menu__close svg{width:1.1em;height:1.1em;}
.aether-mobile-menu__logo{font-size:1.6rem;font-weight:800;letter-spacing:0.3em;color:var(--aether-text);text-transform:uppercase;text-decoration:none;}
.aether-mobile-menu__spacer{width:44px;min-width:44px;}
.aether-mobile-menu__body{flex:1;display:flex;flex-direction:column;padding:24px 20px;overflow-y:auto;}
.aether-mobile-search{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:14px 16px;margin-bottom:28px;}
.aether-mobile-search__icon{color:rgba(255,255,255,0.4);width:0.9rem;height:0.9rem;flex-shrink:0;}
.aether-mobile-search input{flex:1;background:none;border:none;outline:none;color:var(--aether-text);font-size:0.9rem;}
.aether-mobile-search input::placeholder{color:rgba(255,255,255,0.35);}
.aether-mobile-nav{display:flex;flex-direction:column;}
.aether-mobile-nav__link{display:flex;align-items:center;min-height:48px;padding:12px 0;font-size:1rem;font-weight:500;color:var(--aether-text);text-decoration:none;transition:color 0.2s ease;border-bottom:1px solid rgba(255,255,255,0.04);}
.aether-mobile-nav__link:hover,.aether-mobile-nav__link:active,.aether-mobile-nav__link.active{color:var(--aether-accent);}
.aether-mobile-nav__link:last-child{border-bottom:none;}
.aether-mobile-divider{height:1px;background:rgba(255,255,255,0.06);margin:12px 0;}
.aether-mobile-cta{display:flex;align-items:center;justify-content:center;min-height:52px;margin:20px 0;background:var(--aether-accent);color:var(--aether-bg);font-weight:600;font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;border-radius:4px;transition:background 0.2s ease,transform 0.2s ease;}
.aether-mobile-cta:hover{background:var(--aether-primary);transform:translateY(-1px);}
.aether-mobile-socials{display:flex;align-items:center;justify-content:center;gap:28px;padding:16px 0;margin-top:auto;}
.aether-mobile-socials a{color:rgba(255,255,255,0.5);font-size:1.1rem;transition:color 0.2s ease;}
.aether-mobile-socials a svg{width:1.1rem;height:1.1rem;}
.aether-mobile-socials a:hover{color:var(--aether-text);}}{%- comment -%}
── Footer (frozen style.css:1640-1788) ───────────────────── Grid:1.5fr 1fr 1fr 1fr 1.5fr → 2 cols ≤1024 → 1 col centered ≤768 (plan Task 4 responsive addendum). Border color,chrome text and gold hover map to the pack tokens (D-note:token mapping,same as header/announcement). Newsletter uses the PHANTOM newsletter-form snippet — its success/error states are PHANTOM's own (D-newsletter reuse note);the input/button are restyled to the frozen look. Payments use payment_type_svg_tag (frozen FA brand glyphs → SVG set,D-note). {%- endcomment -%}
.aether-footer {padding:80px 0 0;background-color:var(--aether-bg);border-top:1px solid var(--aether-surface);}
.aether-footer__container {width:100%;max-width:var(--aether-container-max);margin:0 auto;padding:0 20px;}
.aether-footer__top {display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1.5fr;gap:40px;padding-bottom:60px;}
.aether-footer__logo {font-size:1.5rem;font-weight:800;letter-spacing:0.3em;text-transform:uppercase;color:var(--aether-text);display:block;margin-bottom:10px;text-decoration:none;}
.aether-footer__logo-image {display:block;height:36px;width:auto;margin-bottom:10px;}
.aether-footer__tagline {font-size:0.9rem;color:var(--aether-muted);margin-bottom:20px;}
.aether-footer__social {display:flex;gap:12px;}
.aether-footer__social a {width:40px;height:40px;border:1px solid var(--aether-surface);display:flex;align-items:center;justify-content:center;color:var(--aether-muted);transition:all 0.2s ease;text-decoration:none;}
.aether-footer__social a:hover {border-color:var(--aether-accent);color:var(--aether-accent);}
.aether-footer__social-icon {width:0.9rem;height:0.9rem;}
.aether-footer__heading {font-size:0.8rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--aether-text);margin:0 0 20px;}
.aether-footer__links ul {margin:0;padding:0;list-style:none;}
.aether-footer__links ul li {margin-bottom:10px;}
.aether-footer__links ul li a {font-size:0.85rem;color:var(--aether-muted);text-decoration:none;transition:color 0.2s ease;}
.aether-footer__links ul li a:hover {color:var(--aether-accent);}
.aether-footer__newsletter p {font-size:0.85rem;color:var(--aether-muted);margin:0 0 16px;line-height:1.6;}
.aether-footer__newsletter .input-group {display:flex;border:1px solid var(--aether-surface);}
.aether-footer__newsletter .newsletter__input {flex:1;padding:12px 16px;background:transparent;border:none;color:var(--aether-text);font-size:0.85rem;min-width:0;}
.aether-footer__newsletter .newsletter__input:focus {outline:none;}
.aether-footer__newsletter .newsletter__input::placeholder {color:rgba(168,181,192,0.5);}
.aether-footer__newsletter .input-group-btn {flex:0 0 auto;}
.aether-footer__newsletter .btn {padding:12px 20px;background:var(--aether-accent);border:none;border-radius:0;color:var(--aether-bg);font-size:0.9rem;height:auto;transition:background 0.2s ease;}
.aether-footer__newsletter .btn:hover {background:#D4A574;color:var(--aether-bg);}
.aether-footer__newsletter .note--success {font-size:0.85rem;color:var(--aether-text);background:transparent;border:1px solid var(--aether-surface);padding:12px 16px;margin:0;}
.aether-footer__bottom {display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px 0;border-top:1px solid var(--aether-surface);}
.aether-footer__legal {display:flex;flex-wrap:wrap;align-items:center;gap:20px;font-size:0.8rem;color:var(--aether-muted);}
.aether-footer__legal a {color:var(--aether-muted);text-decoration:none;transition:color 0.2s ease;}
.aether-footer__legal a:hover {color:var(--aether-accent);}
.aether-footer__payments {display:flex;align-items:center;gap:15px;opacity:0.4;}
.aether-footer__payment-icon {height:24px;width:auto;}
@media (max-width:1024px) {.aether-footer__top {grid-template-columns:1fr 1fr;}}
@media (max-width:768px) {.aether-footer__top {grid-template-columns:1fr;text-align:center;justify-items:center;}
.aether-footer__social {justify-content:center;}
.aether-footer__newsletter .input-group {max-width:340px;margin:0 auto;}
.aether-footer__bottom {flex-direction:column;text-align:center;}
.aether-footer__legal {justify-content:center;}}
@media (max-width:576px) {.aether-footer {padding:56px 0 0;}}
