{%- comment -%}
  AETHER — Design Pack token + chrome stylesheet (Wave 0 T2 skeleton + Wave 1
  T2 announcement bar + T3 header).
  PHANTOM Core contract (§3.4): tokens consume settings.aether_* (Design Packs
  settings group, schema defaults verified against the frozen frontend, 22 pages).
  Wave 1 ships the visual rules; every rule must reference .ph-client--aether or
  a .aether-* class (designs/build/audit-scope.mjs gate, pack prefix). Zero :root,
  zero bare-element overrides, z-index within the pack budget (≤ 10000, reuse the
  5000/9000/9050/9500/9700 scale).
  Frozen references: tokens style.css:1-42; announcement style.css:394-424;
  header style.css:427-629; mobile header + drawer responsive.css:68-285,
  288-428, 394-607 (Task 3 scope).
{%- endcomment -%}
.ph-client--aether {
  --aether-primary: {{ settings.aether_primary | default: '#D4A574' }};
  --aether-accent: {{ settings.aether_accent | default: '#C8956C' }};
  --aether-bg: {{ settings.aether_bg | default: '#09090B' }};
  --aether-surface: {{ settings.aether_surface | default: '#1A1A1A' }};
  --aether-text: {{ settings.aether_text | default: '#F2F2F2' }};
  --aether-muted: {{ settings.aether_muted | default: '#9C9C9C' }};
  --aether-border: {{ settings.aether_border | default: '#2A2A2A' }};
  --aether-sale: {{ settings.aether_sale | default: '#E74C3C' }};
  --aether-radius: {{ settings.aether_radius | default: 12 }}px;
  --aether-scheme: {{ settings.aether_dark_light | default: 'dark' }};
  --aether-announcement-height: 40px;
  --aether-header-height: 80px;
  --aether-container-max: 1200px;
  --aether-z-announcement: 5100;
  --aether-z-sticky: 5000;
  --aether-z-drawer: 9000;
  --aether-z-modal: 9050;
  --aether-z-toast: 9500;
  --aether-z-3d: 9700;
}

/* ── Announcement bar (frozen style.css:394-424) ──────────────
   Single style everywhere: translucent dark chrome (frozen default;
   the transparent .home-page variant is dropped per plan Step 2 —
   D-list record; visual impact: same bar on every page, acceptable).
   Amendment (Task 3, recorded): the frozen layout hides the whole bar
   on ≤ 768 (responsive.css:294-297) and shows the rotating texts inside
   the mobile header row — the mobile rotation lives in the aether-header
   section now (section isolation, plan D2); the bar is hidden entirely. */
.aether-announcement-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--aether-announcement-height);
  background: rgba(9, 9, 11, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--aether-z-announcement);
}

.aether-announcement-bar .announcement-content {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--aether-text);
  opacity: 1;
}

.aether-announcement-bar .announcement-content .separator {
  margin: 0 15px;
  opacity: 0.5;
}

.aether-announcement-bar .aether-announcement-bar__icon {
  width: 0.8em;
  height: 0.8em;
  vertical-align: -1px;
  margin-right: 7px;
}

@media (max-width: 768px) {
  .aether-announcement-bar {
    display: none;
  }
}

/* ── Header (frozen style.css:427-629) ────────────────────────
   Fixed below the announcement bar, smart sticky on scroll
   (controller toggles --scrolled / --hidden on the root). */
.aether-header__bar {
  position: fixed;
  top: var(--aether-announcement-height);
  left: 0;
  right: 0;
  height: var(--aether-header-height);
  display: flex;
  align-items: center;
  z-index: var(--aether-z-sticky);
  background-color: transparent;
  transform: translateY(0);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.35s ease;
  will-change: transform;
}

.aether-header--hidden .aether-header__bar {
  transform: translateY(calc(-100% - var(--aether-announcement-height)));
}

.aether-header--scrolled .aether-header__bar {
  background-color: rgba(9, 9, 11, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.aether-header__container {
  width: 100%;
  max-width: var(--aether-container-max);
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.aether-header__logo {
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: 0.3em;
  color: var(--aether-text);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.aether-header__logo-image {
  height: 36px;
  width: auto;
  display: block;
}

.aether-header__nav {
  display: flex;
}

/* Mobile-only elements inside the nav — hidden on desktop */
.aether-nav__mobile-logo,
.aether-nav__mobile-icons {
  display: none;
}

.aether-nav__links {
  display: flex;
  gap: 40px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.aether-nav__link {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--aether-text);
  position: relative;
  padding: 5px 0;
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

.aether-nav__link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background-color: var(--aether-accent);
  transition: width 0.3s ease;
}

.aether-nav__link:hover::after,
.aether-nav__link.active::after {
  width: 100%;
}

.aether-nav__caret {
  width: 0.6rem;
  height: 0.6rem;
  margin-left: 6px;
  transition: transform 0.3s ease;
}

.aether-nav__item--dropdown:hover .aether-nav__caret,
.aether-nav__item--dropdown.open .aether-nav__caret {
  transform: rotate(180deg);
}

/* ─── Nav dropdown ─────────────────────────────────────── */
.aether-nav__item--dropdown {
  position: relative;
}

.aether-nav__dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  min-width: 200px;
  background: rgba(15, 15, 17, 0.97);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 8px;
  padding: 8px 0;
  margin: 0;
  list-style: none;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
}

.aether-nav__item--dropdown:hover .aether-nav__dropdown,
.aether-nav__item--dropdown.open .aether-nav__dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.aether-nav__dropdown-link {
  display: block;
  padding: 10px 24px;
  font-size: 0.8rem;
  font-weight: 400;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.7);
  white-space: nowrap;
  transition: color 0.2s ease, background 0.2s ease;
  text-decoration: none;
}

.aether-nav__dropdown-link:hover,
.aether-nav__dropdown-link.active {
  color: var(--aether-text);
  background: rgba(255, 255, 255, 0.04);
}

.aether-header__actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.aether-header__icon {
  background: none;
  border: none;
  padding: 0;
  color: var(--aether-text);
  font-size: 1rem;
  cursor: pointer;
  position: relative;
  transition: color 0.2s ease;
  text-decoration: none;
  display: inline-flex;
}

.aether-header__icon:hover {
  color: var(--aether-accent);
}

.aether-header__icon svg {
  width: 1.1em;
  height: 1.1em;
}

.aether-cart-count {
  position: absolute;
  top: -8px;
  right: -8px;
  background-color: var(--aether-accent);
  color: var(--aether-bg);
  font-size: 0.65rem;
  font-weight: 700;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.aether-menu-btn {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
}

.aether-menu-btn span {
  width: 25px;
  height: 2px;
  background-color: var(--aether-text);
  transition: all 0.2s ease;
}

/* ─── Mobile header row + drawer (hidden on desktop) ────── */
.aether-mobile-header,
.aether-mobile-menu-overlay {
  display: none;
}

/* ─── ≤ 1024px: full-screen overlay nav (frozen responsive.css:68-194) ─── */
@media (max-width: 1024px) {
  .aether-header__nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(9, 9, 11, 0.98);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: var(--aether-z-drawer);
  }

  .aether-header__nav.active {
    display: flex;
  }

  .aether-header__nav.active .aether-nav__mobile-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  .aether-nav__mobile-logo .aether-header__logo {
    font-size: 2rem;
    letter-spacing: 0.35em;
  }

  .aether-header__nav.active .aether-nav__mobile-icons {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .aether-nav__mobile-icons .aether-header__icon {
    font-size: 1.1rem;
  }

  .aether-header__actions .aether-header__icon {
    display: none;
  }

  .aether-header__container > .aether-header__logo {
    display: none;
  }

  .aether-nav__links {
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .aether-nav__link {
    font-size: 1.2rem;
  }

  .aether-nav__item--dropdown {
    position: static;
  }

  .aether-nav__dropdown {
    position: static;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    display: none;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    text-align: center;
    min-width: auto;
  }

  .aether-nav__item--dropdown.open .aether-nav__dropdown {
    display: block;
  }

  .aether-nav__dropdown-link {
    padding: 8px 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .aether-nav__dropdown-link:hover,
  .aether-nav__dropdown-link.active {
    background: transparent;
    color: var(--aether-text);
  }

  .aether-menu-btn {
    display: flex;
    z-index: var(--aether-z-drawer);
  }

  .aether-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .aether-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .aether-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }
}

/* ─── ≤ 768px: mobile header + slide-out drawer (frozen
   responsive.css:288-607) ──────────────────────────────── */
@media (max-width: 768px) {
  .aether-header__bar {
    display: none;
  }

  .aether-mobile-header {
    display: flex;
    align-items: center;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    z-index: var(--aether-z-sticky);
    padding: 0 16px;
  }

  /* Home page: transparent mobile header over the hero */
  .aether-header--home .aether-mobile-header {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
  }

  .aether-mobile-hamburger {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
    z-index: var(--aether-z-sticky);
  }

  .aether-mobile-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--aether-text);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .aether-mobile-hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .aether-mobile-hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .aether-mobile-hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Rotating announcement text (frozen responsive.css:365-392) */
  .aether-mobile-announcement {
    flex: 1;
    text-align: center;
    overflow: hidden;
    height: 20px;
    position: relative;
  }

  .aether-mobile-announcement__text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--aether-text);
    opacity: 0;
    transition: opacity 0.5s ease;
    white-space: nowrap;
  }

  .aether-mobile-announcement__text.active {
    opacity: 1;
  }

  /* Slide-out drawer overlay + panel (frozen responsive.css:394-428) */
  .aether-mobile-menu-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: var(--aether-z-drawer);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .aether-mobile-menu-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .aether-mobile-menu {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 400px;
    height: 100%;
    background: rgba(9, 9, 11, 0.95);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .aether-mobile-menu-overlay.active .aether-mobile-menu {
    transform: translateX(0);
  }

  .aether-mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    min-height: 60px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  .aether-mobile-menu__close {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: none;
    border: none;
    color: var(--aether-text);
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aether-mobile-menu__close svg {
    width: 1.1em;
    height: 1.1em;
  }

  .aether-mobile-menu__logo {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    color: var(--aether-text);
    text-transform: uppercase;
    text-decoration: none;
  }

  .aether-mobile-menu__spacer {
    width: 44px;
    min-width: 44px;
  }

  .aether-mobile-menu__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    overflow-y: auto;
  }

  .aether-mobile-search {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 28px;
  }

  .aether-mobile-search__icon {
    color: rgba(255, 255, 255, 0.4);
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
  }

  .aether-mobile-search input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--aether-text);
    font-size: 0.9rem;
  }

  .aether-mobile-search input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .aether-mobile-nav {
    display: flex;
    flex-direction: column;
  }

  .aether-mobile-nav__link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--aether-text);
    text-decoration: none;
    transition: color 0.2s ease;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .aether-mobile-nav__link:hover,
  .aether-mobile-nav__link:active,
  .aether-mobile-nav__link.active {
    color: var(--aether-accent);
  }

  .aether-mobile-nav__link:last-child {
    border-bottom: none;
  }

  .aether-mobile-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 12px 0;
  }

  .aether-mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin: 20px 0;
    background: var(--aether-accent);
    color: var(--aether-bg);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .aether-mobile-cta:hover {
    background: var(--aether-primary);
    transform: translateY(-1px);
  }

  .aether-mobile-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: 16px 0;
    margin-top: auto;
  }

  .aether-mobile-socials a {
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.1rem;
    transition: color 0.2s ease;
  }

  .aether-mobile-socials a svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .aether-mobile-socials a:hover {
    color: var(--aether-text);
  }
}

/* ── Footer (frozen style.css:1640-1788) ─────────────────────
   Grid: 1.5fr 1fr 1fr 1fr 1.5fr → 2 cols ≤1024 → 1 col centered
   ≤768 (plan Task 4 responsive addendum). Border color, chrome
   text and gold hover map to the pack tokens (D-note: token
   mapping, same as header/announcement). Newsletter uses the
   PHANTOM newsletter-form snippet — its success/error states are
   PHANTOM's own (D-newsletter reuse note); the input/button are
   restyled to the frozen look. Payments use payment_type_svg_tag
   (frozen FA brand glyphs → SVG set, D-note). */
.aether-footer {
  padding: 80px 0 0;
  background-color: var(--aether-bg);
  border-top: 1px solid var(--aether-surface);
}

.aether-footer__container {
  width: 100%;
  max-width: var(--aether-container-max);
  margin: 0 auto;
  padding: 0 20px;
}

.aether-footer__top {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr 1.5fr;
  gap: 40px;
  padding-bottom: 60px;
}

.aether-footer__logo {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--aether-text);
  display: block;
  margin-bottom: 10px;
  text-decoration: none;
}

.aether-footer__logo-image {
  display: block;
  height: 36px;
  width: auto;
  margin-bottom: 10px;
}

.aether-footer__tagline {
  font-size: 0.9rem;
  color: var(--aether-muted);
  margin-bottom: 20px;
}

.aether-footer__social {
  display: flex;
  gap: 12px;
}

.aether-footer__social a {
  width: 40px;
  height: 40px;
  border: 1px solid var(--aether-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--aether-muted);
  transition: all 0.2s ease;
  text-decoration: none;
}

.aether-footer__social a:hover {
  border-color: var(--aether-accent);
  color: var(--aether-accent);
}

.aether-footer__social-icon {
  width: 0.9rem;
  height: 0.9rem;
}

.aether-footer__heading {
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--aether-text);
  margin: 0 0 20px;
}

.aether-footer__links ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.aether-footer__links ul li {
  margin-bottom: 10px;
}

.aether-footer__links ul li a {
  font-size: 0.85rem;
  color: var(--aether-muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.aether-footer__links ul li a:hover {
  color: var(--aether-accent);
}

.aether-footer__newsletter p {
  font-size: 0.85rem;
  color: var(--aether-muted);
  margin: 0 0 16px;
  line-height: 1.6;
}

.aether-footer__newsletter .input-group {
  display: flex;
  border: 1px solid var(--aether-surface);
}

.aether-footer__newsletter .newsletter__input {
  flex: 1;
  padding: 12px 16px;
  background: transparent;
  border: none;
  color: var(--aether-text);
  font-size: 0.85rem;
  min-width: 0;
}

.aether-footer__newsletter .newsletter__input:focus {
  outline: none;
}

.aether-footer__newsletter .newsletter__input::placeholder {
  color: rgba(168, 181, 192, 0.5);
}

.aether-footer__newsletter .input-group-btn {
  flex: 0 0 auto;
}

.aether-footer__newsletter .btn {
  padding: 12px 20px;
  background: var(--aether-accent);
  border: none;
  border-radius: 0;
  color: var(--aether-bg);
  font-size: 0.9rem;
  height: auto;
  transition: background 0.2s ease;
}

.aether-footer__newsletter .btn:hover {
  background: #D4A574;
  color: var(--aether-bg);
}

.aether-footer__newsletter .note--success {
  font-size: 0.85rem;
  color: var(--aether-text);
  background: transparent;
  border: 1px solid var(--aether-surface);
  padding: 12px 16px;
  margin: 0;
}

.aether-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 0;
  border-top: 1px solid var(--aether-surface);
}

.aether-footer__legal {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
  font-size: 0.8rem;
  color: var(--aether-muted);
}

.aether-footer__legal a {
  color: var(--aether-muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.aether-footer__legal a:hover {
  color: var(--aether-accent);
}

.aether-footer__payments {
  display: flex;
  align-items: center;
  gap: 15px;
  opacity: 0.4;
}

.aether-footer__payment-icon {
  height: 24px;
  width: auto;
}

@media (max-width: 1024px) {
  .aether-footer__top {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .aether-footer__top {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
  }

  .aether-footer__social {
    justify-content: center;
  }

  .aether-footer__newsletter .input-group {
    max-width: 340px;
    margin: 0 auto;
  }

  .aether-footer__bottom {
    flex-direction: column;
    text-align: center;
  }

  .aether-footer__legal {
    justify-content: center;
  }
}

@media (max-width: 576px) {
  .aether-footer {
    padding: 56px 0 0;
  }
}
