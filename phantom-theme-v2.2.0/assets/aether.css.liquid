Home page:transparent mobile header over the hero{%- endcomment -%}
.aether-header--home .aether-mobile-header{background:transparent;backdrop-filter:none;-webkit-backdrop-filter:none;border-bottom:none;}
.aether-mobile-hamburger{width:44px;height:44px;min-width:44px;background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:0;z-index:var(--aether-z-sticky);}
.aether-mobile-hamburger span{display:block;width:22px;height:2px;background:var(--aether-text);border-radius:2px;transition:all 0.3s ease;}
