Product card (frozen .product-card 1008-1141,rich index.html:400-425) {%- endcomment -%}
.aether-product-card {border:1px solid var(--aether-surface);transition:all 0.3s ease;background:var(--aether-bg);cursor:pointer;position:relative;}
.aether-product-card:hover {border-color:var(--aether-accent);box-shadow:0 8px 40px rgba(200,149,108,0.08);transform:translateY(-4px);}
