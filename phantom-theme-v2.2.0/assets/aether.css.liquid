{%- comment -%} AETHER pack stylesheet: tokens + chrome + shared components (frozen-source mapping per component in docs/design-packs). {%- endcomment -%}
.ph-client--aether{--aether-primary:{{settings.aether_primary | default:'#D4A574'}};--aether-accent:{{settings.aether_accent | default:'#C8956C'}};--aether-bg:{{settings.aether_bg | default:'#09090B'}};--aether-surface:{{settings.aether_surface | default:'#1A1A1A'}};--aether-text:{{settings.aether_text | default:'#F2F2F2'}};--aether-muted:{{settings.aether_muted | default:'#9C9C9C'}};--aether-border:{{settings.aether_border | default:'#2A2A2A'}};--aether-sale:{{settings.aether_sale | default:'#E74C3C'}};--aether-radius:{{settings.aether_radius | default:12}}px;--aether-scheme:{{settings.aether_dark_light | default:'dark'}};--aether-announcement-height:40px;--aether-header-height:80px;--aether-container-max:1200px;--aether-z-announcement:5100;--aether-z-sticky:5000;--aether-z-drawer:9000;--aether-z-modal:9050;--aether-z-toast:9500;--aether-z-3d:9700;}{%- comment -%}
── Announcement bar (frozen style.css:394-424) ────────────── Single style everywhere:translucent dark chrome (frozen default;the transparent .home-page variant is dropped per plan Step 2 — D-list record;visual impact:same bar on every page,acceptable). Amendment (Task 3,recorded):the frozen layout hides the whole bar on ≤ 768 (responsive.css:294-297) and shows the rotating texts inside the mobile header row — the mobile rotation lives in the aether-header section now (section isolation,plan D2);the bar is hidden entirely.{%- endcomment -%}
.aether-announcement-bar{position:fixed;top:0;left:0;right:0;height:var(--aether-announcement-height);background:rgba(9,9,11,0.85);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;z-index:var(--aether-z-announcement);}
.aether-announcement-bar .announcement-content{font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--aether-text);opacity:1;}
.aether-announcement-bar .announcement-content .separator{margin:0 15px;opacity:0.5;}
.aether-announcement-bar .aether-announcement-bar__icon{width:0.8em;height:0.8em;vertical-align:-1px;margin-right:7px;}
@media (max-width:768px){.aether-announcement-bar{display:none;}}{%- comment -%}
── Header (frozen style.css:427-629) ──────────────────────── Fixed below the announcement bar,smart sticky on scroll (controller toggles --scrolled / --hidden on the root).{%- endcomment -%}
.aether-header__bar{position:fixed;top:var(--aether-announcement-height);left:0;right:0;height:var(--aether-header-height);display:flex;align-items:center;z-index:var(--aether-z-sticky);background-color:transparent;transform:translateY(0);transition:transform 0.35s cubic-bezier(0.4,0,0.2,1),background-color 0.35s ease;will-change:transform;}
.aether-header--hidden .aether-header__bar{transform:translateY(calc(-100% - var(--aether-announcement-height)));}
.aether-header--scrolled .aether-header__bar{background-color:rgba(9,9,11,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.04);}
.aether-header__container{width:100%;max-width:var(--aether-container-max);margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;}
.aether-header__logo{font-size:1.8rem;font-weight:800;letter-spacing:0.3em;color:var(--aether-text);text-transform:uppercase;display:flex;align-items:center;gap:10px;text-decoration:none;}
.aether-header__logo-image{height:36px;width:auto;display:block;}
.aether-header__nav{display:flex;}{%- comment -%}
Mobile-only elements inside the nav — hidden on desktop{%- endcomment -%}
.aether-nav__mobile-logo,.aether-nav__mobile-icons{display:none;}
.aether-nav__links{display:flex;gap:40px;margin:0;padding:0;list-style:none;}
.aether-nav__link{font-size:0.85rem;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;color:var(--aether-text);position:relative;padding:5px 0;display:inline-flex;align-items:center;text-decoration:none;}
.aether-nav__link::after{content:'';position:absolute;bottom:0;left:0;width:0;height:1px;background-color:var(--aether-accent);transition:width 0.3s ease;}
.aether-nav__link:hover::after,.aether-nav__link.active::after{width:100%;}
.aether-nav__caret{width:0.6rem;height:0.6rem;margin-left:6px;transition:transform 0.3s ease;}
.aether-nav__item--dropdown:hover .aether-nav__caret,.aether-nav__item--dropdown.open .aether-nav__caret{transform:rotate(180deg);}{%- comment -%}
─── Nav dropdown ───────────────────────────────────────{%- endcomment -%}
.aether-nav__item--dropdown{position:relative;}
.aether-nav__dropdown{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(8px);min-width:200px;background:rgba(15,15,17,0.97);border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:8px 0;margin:0;list-style:none;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 0.3s ease,visibility 0.3s ease,transform 0.3s ease;}
.aether-nav__item--dropdown:hover .aether-nav__dropdown,.aether-nav__item--dropdown.open .aether-nav__dropdown{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);}
.aether-nav__dropdown-link{display:block;padding:10px 24px;font-size:0.8rem;font-weight:400;letter-spacing:0.05em;text-transform:uppercase;color:rgba(255,255,255,0.7);white-space:nowrap;transition:color 0.2s ease,background 0.2s ease;text-decoration:none;}
.aether-nav__dropdown-link:hover,.aether-nav__dropdown-link.active{color:var(--aether-text);background:rgba(255,255,255,0.04);}
.aether-header__actions{display:flex;align-items:center;gap:20px;}
.aether-header__icon{background:none;border:none;padding:0;color:var(--aether-text);font-size:1rem;cursor:pointer;position:relative;transition:color 0.2s ease;text-decoration:none;display:inline-flex;}
.aether-header__icon:hover{color:var(--aether-accent);}
.aether-header__icon svg{width:1.1em;height:1.1em;}
.aether-cart-count{position:absolute;top:-8px;right:-8px;background-color:var(--aether-accent);color:var(--aether-bg);font-size:0.65rem;font-weight:700;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.aether-menu-btn{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:5px;}
.aether-menu-btn span{width:25px;height:2px;background-color:var(--aether-text);transition:all 0.2s ease;}{%- comment -%}
─── Mobile header row + drawer (hidden on desktop) ──────{%- endcomment -%}
.aether-mobile-header,.aether-mobile-menu-overlay{display:none;}{%- comment -%}
─── ≤ 1024px:full-screen overlay nav (frozen responsive.css:68-194) ───{%- endcomment -%}
